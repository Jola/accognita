// Dev-Container für Absorb & Evolve
// Öffnen: VS Code → „Dev Containers: Reopen in Container“ (oder GitHub Codespaces).
// Danach im Terminal: npm run dev  → Spiel unter http://localhost:8080
{
  "name": "Absorb & Evolve",
  // Node 20 — dieselbe Version wie die CI (.github/workflows/deploy.yml)
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    // GitHub-CLI (gh) — für Pull Requests direkt aus dem Container
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": {
    "deps": "npm ci",
    "claude": "curl -fsSL https://claude.ai/install.sh | bash"
  },
  // Damit `claude` in jedem Terminal gefunden wird
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/node/.local/bin"
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Spiel (npm run dev)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
